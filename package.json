{
  "name": "hermes-agora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal Keycloak-secured chat hub for Hermes profiles and human operators.",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vitest run && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "agora:listener": "tsx src/listener/index.ts",
    "agora:listener:once": "tsx src/listener/index.ts --once",
    "agora:mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.10.0",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jose": "latest",
    "keycloak-js": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "jsdom": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
