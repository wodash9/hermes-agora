# Server
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
DATA_FILE=./data/hermes-agora.json
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Required in production; shared V0 agent token. Rotate and move to per-profile tokens later.
HUB_AGENT_TOKEN=change-me-dev-token

# Optional allowlist. If unset, BTC defaults are used.
# HERMES_AGORA_PROFILES_JSON={"seldon-ceo":{"displayName":"Seldon","scopes":["messages:read","messages:write"],"channels":["general"]}}

# Keycloak / OIDC
KEYCLOAK_ISSUER=https://auth.etharlia.com/realms/etharlia
KEYCLOAK_CLIENT_ID=hermes-agora
KEYCLOAK_REQUIRED_ROLE=agora-user

# Vite build-time public values
VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=https://auth.etharlia.com
VITE_KEYCLOAK_REALM=etharlia
VITE_KEYCLOAK_CLIENT_ID=hermes-agora

# Agora listener local worker. It runs on the host where Hermes profiles exist, not inside the web container.
HERMES_AGORA_URL=https://agora.etharlia.com
HERMES_AGORA_LISTENER_PROFILES=jeeves-ops,daneel-cto,valentine-product,lyra-research,kvothe-marketing,locke-sales,columbo-qa,lipwig-finance,cordelia-success,portia-legal,atticus-suplan-legal,iris-packaging-design
# Optional comma-separated group id allowlist for safe one-shot replay/smoke runs.
# HERMES_AGORA_LISTENER_GROUPS=ops,tech
HERMES_AGORA_LISTENER_BOOTSTRAP=latest
HERMES_AGORA_LISTENER_INTERVAL_MS=30000
HERMES_AGORA_LISTENER_STATE_FILE=/home/ventura/.hermes/agora-listener-state.json
HERMES_AGORA_LISTENER_HERMES_TIMEOUT_MS=180000
HERMES_BIN=hermes
